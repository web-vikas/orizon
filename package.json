{
  "name": "orizon",
  "version": "0.2.1",
  "description": "Ant Design API on shadcn/ui primitives — 68 components for React with Tailwind CSS",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "react",
    "ui",
    "components",
    "component-library",
    "antd",
    "ant-design",
    "shadcn",
    "tailwind",
    "tailwindcss",
    "typescript",
    "accessible"
  ],
  "bin": {
    "orizon": "./bin/cli.mjs"
  },
  "sideEffects": false,
  "main": "./dist/orizon.cjs.js",
  "module": "./dist/orizon.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/orizon.es.js",
      "require": "./dist/orizon.cjs.js"
    },
    "./preset.css": "./dist/preset.css"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-preset.mjs",
    "build:types": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "tailwindcss": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "react-hook-form": {
      "optional": true
    },
    "@hookform/resolvers": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@base-ui/react": "^1.2.0",
    "@eslint/js": "^9.39.1",
    "@fontsource-variable/geist": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "react-day-picker": "^9.14.0",
    "react-hook-form": "^7.71.2",
    "shadcn": "^4.0.0",
    "sonner": "^2.0.7",
    "storybook": "^8.6.14",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vaul": "^1.1.2",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "zod": "^4.3.6"
  }
}
